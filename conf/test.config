/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/ncrnaflow -profile test,<docker/singularity> \
            --rfam_cm /path/to/Rfam.cm \
            --rfam_seed /path/to/Rfam.seed \
            --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Pipeline mode — use invertebrates for faster test (100 kbp chunks)
    mode       = 'ensembl-invertebrates'

    // Small test genome: Caenorhabditis elegans chromosome I (first 500 kbp)
    // TODO: replace with a versioned URL on nf-core/test-datasets once data is uploaded
    fasta      = params.pipelines_testdata_base_path + 'ncrnaflow/genome/test_genome.fa'

    // Rfam reference files must be supplied by the user or set in a site config.
    // rfam_cm  = '/path/to/Rfam.cm'
    // rfam_seed = '/path/to/Rfam.seed'
}
